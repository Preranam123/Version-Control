	column 'Salary Band' =
			
			SWITCH(
			    TRUE(),
			    employee_master[yearly_salary] < 300000, "< 3 Lakh",
			    employee_master[yearly_salary] < 500000, "3 - 5 Lakh",
			    employee_master[yearly_salary] < 1000000, "5 - 10 Lakh",
			    employee_master[yearly_salary] < 1500000, "10 - 15 Lakh",
			    employee_master[yearly_salary] < 2000000, "15 - 20 Lakh",
			    employee_master[yearly_salary] < 2500000, "20 - 25 Lakh",
			    employee_master[yearly_salary] < 3000000, "25 - 30 Lakh",
			    "30+ Lakh"
			)
		lineageTag: fb6e4108-9b36-4c47-8c03-02e0da9c7ac9
		summarizeBy: none
		sortByColumn: 'Salary Band Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Salary Band Sort' =
			
			SWITCH(
			    TRUE(),
			    employee_master[yearly_salary] < 300000, 1,
			    employee_master[yearly_salary] < 500000, 2,
			    employee_master[yearly_salary] < 1000000, 3,
			    employee_master[yearly_salary] < 1500000, 4,
			    employee_master[yearly_salary] < 2000000, 5,
			    employee_master[yearly_salary] < 2500000, 6,
			    employee_master[yearly_salary] < 3000000, 7,
			    8
			)
		formatString: 0
		lineageTag: fb1a797e-7ffb-4a8e-9095-5b0bf07e18da
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Tenure Band' =
			
			SWITCH(
			    TRUE(),
			    employee_master[years_at_company] < 1, "< 1 Year",
			    employee_master[years_at_company] < 2, "1 - 2 Years",
			    employee_master[years_at_company] < 3, "2 - 3 Years",
			    employee_master[years_at_company] < 5, "3 - 5 Years",
			    employee_master[years_at_company] < 10, "5 - 10 Years",
			    "10+ Years"
			)
		lineageTag: 66ef1246-5851-41df-b874-979b9631a053
		summarizeBy: none
		sortByColumn: 'Tenure Band Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Tenure Band Sort' =
			
			SWITCH(
			    TRUE(),
			    employee_master[years_at_company] < 1, 1,
			    employee_master[years_at_company] < 2, 2,
			    employee_master[years_at_company] < 3, 3,
			    employee_master[years_at_company] < 5, 4,
			    employee_master[years_at_company] < 10, 5,
			    6
			)
		formatString: 0
		lineageTag: 2765ca45-8058-4da6-9608-a594493041e3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Band' =
			
			SWITCH(
			    TRUE(),
			    employee_master[age] < 25, "< 25",
			    employee_master[age] < 35, "25 - 34",
			    employee_master[age] < 45, "35 - 44",
			    employee_master[age] < 55, "45 - 54",
			    "55+"
			)
		lineageTag: df362053-04cd-4fbe-921b-5069388b96b2
		summarizeBy: none
		sortByColumn: 'Age Band Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Age Band Sort' =
			
			SWITCH(
			    TRUE(),
			    employee_master[age] < 25, 1,
			    employee_master[age] < 35, 2,
			    employee_master[age] < 45, 3,
			    employee_master[age] < 55, 4,
			    5
			)
		formatString: 0
		lineageTag: 8a30db50-fd99-4238-9b35-ef3889253315
		summarizeBy: sum

